# Copy to .env.local for development. Never commit real values — .env* is
# already gitignored. In production, set these in Vercel's encrypted project
# environment variables, never in a file that gets committed or in chat.

# --- Supabase (server-only; SERVICE_ROLE_KEY must never reach the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public project URL + anon key, used by the browser for traveler login/signup
# (Supabase Auth). The anon key is safe to expose; RLS governs access.
# Both required — `next build` fails loudly if either is missing (see
# next.config.ts) rather than silently shipping a broken login page.
#
# Find these in the Supabase dashboard: Project Settings > API.
#   NEXT_PUBLIC_SUPABASE_URL     -> "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY -> "Project API keys" section — on newer
#     projects this same key is labeled "anon" / "public" or "publishable"
#     depending on when the project was created. Same key either way; paste
#     it into this variable name regardless of what the dashboard calls it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Razorpay ---
# Public key id — safe to expose to the browser via NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only secrets. Use rzp_test_/test-mode keys for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
# Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="TripMySoul <bookings@yourdomain.com>"
# Internal inbox that gets a copy of every booking confirmation.
RESEND_BOOKINGS_INBOX="bookings-internal@yourdomain.com"

# --- Email/OTP verification ---
# Secret used to (a) HMAC-hash OTP codes before they're stored, so a DB read
# never exposes a plaintext code, and (b) sign the short-lived "email
# verified" token the booking endpoint requires. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_VERIFICATION_SECRET=

# --- Internal ---
# Shared secret for /api/internal/cron. Also read by Vercel Cron automatically
# as the Bearer token if a variable named exactly CRON_SECRET is set.
CRON_SECRET=
