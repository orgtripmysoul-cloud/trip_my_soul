# Copy to .env.local for development. Never commit real values — .env* is
# already gitignored. In production, set these in Vercel's encrypted project
# environment variables, never in a file that gets committed or in chat.

# --- Supabase (server-only; SERVICE_ROLE_KEY must never reach the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
# Public key id — safe to expose to the browser via NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only secrets. Use rzp_test_/test-mode keys for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
# Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="TripMySoul <bookings@yourdomain.com>"

# --- Internal ---
# Shared secret for /api/internal/cron. Also read by Vercel Cron automatically
# as the Bearer token if a variable named exactly CRON_SECRET is set.
CRON_SECRET=
